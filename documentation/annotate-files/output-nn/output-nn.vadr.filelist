# list of failing sequences saved in:                                                output-nn.vadr.fail.list
# list of alerts in the feature tables saved in:                                     output-nn.vadr.alt.list
# fasta file with passing sequences saved in:                                        output-nn.vadr.pass.fa
# fasta file with failing sequences saved in:                                        output-nn.vadr.fail.fa
# per-sequence tabular classification summary file saved in:                         output-nn.vadr.sqc
# per-model tabular summary file saved in:                                           output-nn.vadr.mdl
# per-sequence tabular annotation summary file saved in:                             output-nn.vadr.sqa
# per-feature tabular summary file saved in:                                         output-nn.vadr.ftr
# per-model-segment tabular summary file saved in:                                   output-nn.vadr.sgm
# per-alert tabular summary file saved in:                                           output-nn.vadr.alt
# alert count tabular summary file saved in:                                         output-nn.vadr.alc
# alignment doctoring tabular summary file saved in:                                 output-nn.vadr.dcr
